<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_register_form_inherit_wht" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="widget">monetary</attribute>
            </xpath>

            <xpath expr="//form/group/group[@name='group2']/label[@for='amount']" position="before">
                <field name="due_amount" force_save="1" required="1" readonly="1" invisible="1"/>
                <field name="type_payment" force_save="1" required="1" widget="radio"/>
                <field name="payment_value" force_save="1" required="1" widget="monetary"/>
            </xpath>

            <xpath expr="//form/group/group[@name='group1']/field[@name='group_payment']" position="after">
                <field name="cheque_id" force_save="1" required="0"/>
            </xpath>

            <xpath expr="//form/group[1]" position="after">
                <label for="is_apply_wht" class="oe_edit_only" string="Apply WHT"/>
                <field name="is_apply_wht" widget="boolean_toggle"/>
                <br/>
                <br/>

                <field name="wht_line_ids" invisible="not is_apply_wht">
                    <list editable="bottom">
                        <field name="payment_reg_id" column_invisible="1"
                               options="{'no_open': True, 'no_create': True}"/>
                        <field name="wht_category_id" width="150px" options="{'no_open': True, 'no_create': True}"/>
                        <field name="wht_id" width="150px" options="{'no_open': True, 'no_create': True}"
                               domain="[('wht_category_id', '=', wht_category_id)]"/>
                        <field name="wht_name" width="150px"/>
                        <field name="wht_account_id" width="150px" options="{'no_open': True, 'no_create': True}"/>
                        <field name="wht_type" width="150px" widget="badge"/>
                        <field name="wht_value" width="150px" sum="Total Value" widget="monetary"/>
                        <field name="wht_amount" width="150px" sum="Total Amount" readonly="0" force_save="1" widget="monetary"/>
                    </list>
                </field>
                <br/>
                <br/>

                <group name="total_group" col="6" invisible="not is_apply_wht">

                    <group string="WHT Totals" class="oe_subtotal_footer oe_right" colspan="2" name="wht_total">

                        <field name="total_bank_amount" force_save="1" invisible="not is_apply_wht" widget="monetary"/>
                        <field name="total_wht_amount" force_save="1" invisible="1"/>

                        <field name="wht_grouped_data" readonly="1"
                               style="white-space: pre-line; font-weight: bold;"/>
                        <br/>
                        <br/>

                        <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                            <label for="amount" string="Total Payable Amount"/>
                        </div>
                        <field name="amount" force_save="1" nolabel="1" readonly="1"
                               class="oe_subtotal_footer_separator" widget="monetary"/>
                    </group>

                </group>

            </xpath>

        </field>
    </record>


    <record id="view_account_payment_form_inherit_wht" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/group[@name='main_group']/group[@name='group2']/field[@name='payment_method_line_id']"
                   position="after">
                <field name="invoice_no" force_save="1" readonly="state != 'draft'" required="0" invisible="1"/>
                <field name="cheque_id" force_save="1" readonly="state != 'draft'" required="0"/>
                <field name="is_test" force_save="1" readonly="state != 'draft'" required="0" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='action_post']" position="after">
                <button name="compute_wht_entries" string="Compute WHT" class="oe_highlight" type="object"
                        invisible="state != 'draft'" groups="trionex_access_rights.group_checked"/>
            </xpath>


            <xpath expr="//form/sheet/group[@name='main_group']" position="after">
                <label for="is_apply_wht" string="Apply WHT" invisible="not is_test"/>
                <field name="is_apply_wht" force_save="1" nolabel="1" readonly="state != 'draft'"
                       widget="boolean_toggle" invisible="not is_test"/>
                <field name="payment_wht_line_ids" invisible="not is_apply_wht or not is_test" force_save="1"
                       readonly="state != 'draft'">
                    <list editable="bottom">
                        <field name="wht_category_id" width="150px" options="{'no_open': True, 'no_create': True}"/>
                        <field name="wht_id" width="150px" options="{'no_open': True, 'no_create': True}"
                               domain="[('wht_category_id', '=', wht_category_id)]"/>
                        <field name="wht_account_id" width="150px" force_save="1" options="{'no_open': True, 'no_create': True}"/>
                        <field name="wht_value" width="150px" force_save="1" widget="monetary"/>
                        <field name="wht_amount" width="150px" force_save="1" widget="monetary"/>
                    </list>
                </field>
                <br/>
                <br/>

                <group name="total_group" col="6" invisible="not is_apply_wht">
                    <group string="WHT Totals" class="oe_subtotal_footer oe_right" colspan="2" name="wht_total">
                        <field name="total_bank_amount" force_save="1" invisible="not is_apply_wht" widget="monetary"/>
                        <field name="total_wht_amount" force_save="1" invisible="1"/>
                        <field name="wht_grouped_data" readonly="1"
                               style="white-space: pre-line; font-weight: bold;"/>
                        <br/>
                        <br/>
                        <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                            <label for="amount" string="Total Payable Amount"/>
                        </div>
                        <field name="amount" force_save="1" nolabel="1" readonly="1"
                               class="oe_subtotal_footer_separator" widget="monetary"/>
                    </group>
                </group>

            </xpath>

            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="force_save">1</attribute>
                <!--                <attribute name="string">Payment 4565</attribute>-->
            </xpath>

        </field>
    </record>


</odoo>
