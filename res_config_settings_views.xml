<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.trionex.pos.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="inside">

                <!-- Display Stock -->
                <setting id="trionex_pos_stock_setting"
                         string="Display Stock in POS"
                         help="Show on-hand quantity on product cards and order lines">
                    <field name="pos_pos_display_stock"/>
                    <div class="content-group" invisible="not pos_pos_display_stock">
                        <div class="mt8">
                            <label for="pos_stock_location_id" string="Stock Location"/>
                            <field name="pos_stock_location_id" class="oe_inline"/>
                        </div>
                    </div>
                </setting>

                <!-- Restrict Low Stock -->

            </xpath>
        </field>
    </record>
</odoo>